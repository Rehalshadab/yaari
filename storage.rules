rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Call recordings: only admin can read
    match /recordings/{callId} {
      allow read: if request.auth != null && request.auth.token.email == "admin@yaari.com";
      allow write: if request.auth != null;
      allow delete: if false;
    }

    // Profile pictures: user can write own, anyone can read
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
