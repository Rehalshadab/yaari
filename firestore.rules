rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'gender'])
        && request.resource.data.displayName is string
        && request.resource.data.gender in ['male', 'female']
        && request.resource.data.coins == 0
        && request.resource.data.earnings == 0;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /calls/{callId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.callerId
        || request.auth.uid == resource.data.receiverId
        || request.auth.token.email == "rehalon786@gmail.com"
      );
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['callerId', 'receiverId', 'type'])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.status == 'ringing';
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.callerId
        || request.auth.uid == resource.data.receiverId
      );
      allow delete: if false;

      match /signaling/{signalId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
          || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
        );
      }
    }

    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || request.auth.token.email == "rehalon786@gmail.com"
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.amount is number
        && request.resource.data.amount >= 50
        && request.resource.data.status == 'pending';
      allow update: if request.auth.token.email == "rehalon786@gmail.com";
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || request.auth.token.email == "rehalon786@gmail.com"
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.type == 'deposit'
        && request.resource.data.status == 'pending'
        && request.resource.data.coins is number
        && request.resource.data.coins > 0;
      allow update: if request.auth.token.email == "rehalon786@gmail.com";
      allow delete: if false;
    }
  }
}
