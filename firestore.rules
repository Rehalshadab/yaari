rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read by any auth user, write only own doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Calls: participants can read, admin can read all
    match /calls/{callId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        request.auth.token.email == "admin@yaari.com"
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId
      );
      allow delete: if false;

      // Signaling data: only call participants
      match /signaling/{signalId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId
        );
      }
    }

    // Withdrawals: user creates/reads own, admin reads/updates all
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == "admin@yaari.com"
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.token.email == "admin@yaari.com";
      allow delete: if false;
    }
  }
}
